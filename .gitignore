# ============================================================
# Privacy & Security: Electricity Bills & Personal Documents
# ============================================================
# Ignore all PDF files (raw bills contain names, addresses, consumer IDs)
*.pdf
SEP.pdf

# Historical & Uploaded Bills
data/historical/*
!data/historical/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# Processed data containing OCR transcripts & PII
data/processed/*
!data/processed/.gitkeep
!data/processed/historical_bills.json

# Generated Vector Database & Embeddings
vector_db/*
!vector_db/.gitkeep

# Backup & Transaction Rollback Files
*.bak
*.rollback
*.tmp
*.tmp.*
.*.tmp*

# ============================================================
# Logs, Cache & OS Artifacts
# ============================================================
*.log
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
